# Place this server block in nginx after replacing the hostname and TLS paths.
# Keep NetworkMap itself on 127.0.0.1:8765 with NETWORKMAP_TOKEN configured.
server {
    listen 443 ssl http2;
    server_name networkmap.example.net;

    ssl_certificate     /etc/letsencrypt/live/networkmap.example.net/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/networkmap.example.net/privkey.pem;
    add_header Strict-Transport-Security "max-age=31536000" always;

    # Matches the server's maximum JSON import/request size.
    client_max_body_size 32m;

    location / {
        proxy_pass http://127.0.0.1:8765;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection "";

        # NetworkMap's built-in HTTP listener cannot infer external HTTPS.
        proxy_cookie_flags networkmap_token secure httponly samesite=strict;
    }

    location /api/events {
        proxy_pass http://127.0.0.1:8765;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection "";
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 1h;
        proxy_cookie_flags networkmap_token secure httponly samesite=strict;
    }
}

# Add a separate port-80 server that redirects this hostname to HTTPS. Do not
# expose the upstream port through the firewall.
