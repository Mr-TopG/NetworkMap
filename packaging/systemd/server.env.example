# Copy this file to ~/.config/networkmap/server.env and run:
#   systemctl --user restart networkmap
# Keep the real file private: chmod 600 ~/.config/networkmap/server.env

NETWORKMAP_HOST=127.0.0.1
NETWORKMAP_PORT=8765

# Generate a long value, for example: python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
# NETWORKMAP_TOKEN=replace-this-with-a-long-random-value
